# Optional: OpenAI API Key for AI-assisted schema planning
# If not provided, the system will use local schema templates (more private)
OPENAI_API_KEY=

# Directory for storing generated datasets (defaults to /tmp/synthetic-datasets)
OUTPUT_DIR=/tmp/synthetic-datasets

# Maximum rows per request (default: 1000000)
MAX_ROWS=1000000

# Rate limiting (requests per minute per IP)
RATE_LIMIT=10

# Convex Configuration (for user authentication and history)
# Get these from your Convex project dashboard
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Note: GitHub OAuth credentials (AUTH_GITHUB_ID, AUTH_GITHUB_SECRET)
# should be set in your Convex dashboard under Settings > Environment Variables
